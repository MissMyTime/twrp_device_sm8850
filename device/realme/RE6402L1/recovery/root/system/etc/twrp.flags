# mount point   fstype  device                                          device2             flags
# Logical partitions
/system_ext     ext4    system_ext                                                          flags=display=System_EXT
/system_dlkm    ext4    system_dlkm                                                         flags=display=System_DLKM
/vendor_dlkm    ext4    vendor_dlkm                                                         flags=display=Vendor_DLKM

# Userdata/Metadata partitions
/metadata       f2fs    /dev/block/by-name/metadata                                         flags=display="Metadata";backup=1;flashimg=1

# Boot partitions
/boot_a         emmc    /dev/block/bootdevice/by-name/boot_a                                flags=display="Boot A";backup=1;flashimg=1
/boot_b         emmc    /dev/block/bootdevice/by-name/boot_b                                flags=display="Boot B";backup=1;flashimg=1
/init_boot_a    emmc    /dev/block/bootdevice/by-name/init_boot_a                           flags=display="Init Boot A";backup=1;flashimg=1
/init_boot_b    emmc    /dev/block/bootdevice/by-name/init_boot_b                           flags=display="Init Boot B";backup=1;flashimg=1
/vendor_boot_a  emmc    /dev/block/bootdevice/by-name/vendor_boot_a                         flags=display="Vendor Boot A";backup=1;flashimg=1
/vendor_boot_b  emmc    /dev/block/bootdevice/by-name/vendor_boot_b                         flags=display="Vendor Boot B";backup=1;flashimg=1
/recovery_a     emmc    /dev/block/bootdevice/by-name/recovery_a                            flags=display="Recovery A";backup=1;flashimg=1
/recovery_b     emmc    /dev/block/bootdevice/by-name/recovery_b                            flags=display="Recovery B";backup=1;flashimg=1
/dtbo_a         emmc    /dev/block/bootdevice/by-name/dtbo_a                                flags=display="DTBO A";backup=1;flashimg=1
/dtbo_b         emmc    /dev/block/bootdevice/by-name/dtbo_b                                flags=display="DTBO B";backup=1;flashimg=1

# AVB partitions
/vbmeta_a         emmc  /dev/block/bootdevice/by-name/vbmeta_a                              flags=display="VBMeta A";backup=1;flashimg=1
/vbmeta_b         emmc  /dev/block/bootdevice/by-name/vbmeta_b                              flags=display="VBMeta B";backup=1;flashimg=1
/vbmeta_system_a  emmc  /dev/block/bootdevice/by-name/vbmeta_system_a                       flags=display="VBMeta System A";backup=1;flashimg=1
/vbmeta_system_b  emmc  /dev/block/bootdevice/by-name/vbmeta_system_b                       flags=display="VBMeta System B";backup=1;flashimg=1
/vbmeta_vendor_a  emmc  /dev/block/bootdevice/by-name/vbmeta_vendor_a                       flags=display="VBMeta Vendor A";backup=1;flashimg=1
/vbmeta_vendor_b  emmc  /dev/block/bootdevice/by-name/vbmeta_vendor_b                       flags=display="VBMeta Vendor B";backup=1;flashimg=1

# Persistent Firmware & Properties
/firmware       vfat    /dev/block/bootdevice/by-name/modem                                 flags=slotselect;display="Firmware";mounttodecrypt;fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0"
/persist        ext4    /dev/block/bootdevice/by-name/persist                               flags=display="Persist"
/persist_image  emmc    /dev/block/bootdevice/by-name/persist                               flags=display="Persist";backup=1

# Modem partitions
/modem          emmc    /dev/block/bootdevice/by-name/modem                                 flags=slotselect;backup=1;display="Modem"
/bluetooth      emmc    /dev/block/bootdevice/by-name/bluetooth                             flags=slotselect;backup=1;subpartitionof=/modem
/dsp            emmc    /dev/block/bootdevice/by-name/dsp                                   flags=slotselect;backup=1;subpartitionof=/modem

# EFS partitions
/efs1           emmc    /dev/block/bootdevice/by-name/modemst1                              flags=backup=1;display="EFS"
/efs2           emmc    /dev/block/bootdevice/by-name/modemst2                              flags=backup=1;subpartitionof=/efs1
/efsc           emmc    /dev/block/bootdevice/by-name/fsc                                   flags=backup=1;subpartitionof=/efs1
/efsg           emmc    /dev/block/bootdevice/by-name/fsg                                   flags=backup=1;subpartitionof=/efs1

# Removable storage
/storage        auto    /data/media/0                                                       flags=display="Internal Storage";backup=1;usermrf;storage;fsflags="bind,utf8";removable
/usb_otg        vfat    /dev/block/sdg1                            /dev/block/sdg           flags=display="USB-Storage";fsflags=utf8;storage;wipeingui;removable
/SDKa           f2fs    /dev/block/by-name/rannki                                        flags=display="Virtual SD Card";storage;wipeingui;removable
#
