+static bool IsEvolutionXAndroid17() {
+    std::string cmdline;
+    if (!android::base::ReadFileToString("/proc/cmdline", &cmdline)) return false;
+    return cmdline.find("swinfo.fingerprint=EvolutionX-17.") != std::string::npos ||
+           cmdline.find("mtdoops.fingerprint=EvolutionX-17.") != std::string::npos ||
+           cmdline.find("bootmonitor.fingerprint=EvolutionX-17.") != std::string::npos;
+}
+
+static bool ExistingPolicyMatches(int fd, const fscrypt_policy_v1& expected) {
+    fscrypt_get_policy_ex_arg current = {};
+    current.policy_size = sizeof(current.policy);
+    if (ioctl(fd, FS_IOC_GET_ENCRYPTION_POLICY_EX, &current) != 0) return false;
+    return current.policy.version == FSCRYPT_POLICY_V1 &&
+           memcmp(&current.policy.v1, &expected, sizeof(expected)) == 0;
+}
+
+static bool ExistingPolicyMatches(int fd, const fscrypt_policy_v2& expected) {
+    fscrypt_get_policy_ex_arg current = {};
+    current.policy_size = sizeof(current.policy);
+    if (ioctl(fd, FS_IOC_GET_ENCRYPTION_POLICY_EX, &current) != 0) return false;
+    return current.policy.version == FSCRYPT_POLICY_V2 &&
+           memcmp(&current.policy.v2, &expected, sizeof(expected)) == 0;
+}
